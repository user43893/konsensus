{
  "schema": "konsensus.public-repository-boundary",
  "contentRules": [
    {
      "scope": "repository",
      "excludedPaths": ["PUBLICATION-BOUNDARY.json"],
      "forbiddenTerms": [
        "@konsensus/config",
        "@konsensus/db",
        "@konsensus/domain",
        "@konsensus/instance-hukukca",
        "baro",
        "HUKUKCA_",
        "hukukca",
        "hukukça"
      ],
      "forbiddenPatterns": [
        "[.-]v[12](?![0-9])",
        "/api/v[12](?:/|[\"'?#\\s]|$)",
        "\\b(?:V[12]|[A-Z][A-Za-z0-9]*V[12]|[A-Z][A-Z0-9_]*_V[12])\\b"
      ]
    }
  ]
}
